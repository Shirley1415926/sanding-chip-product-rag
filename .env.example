# 生产运行：本地语义 Embedding（首次运行会下载模型）
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# 推荐接入任一 OpenAI Chat Completions 兼容服务；不要把真实 Key 提交到仓库。
LLM_PROVIDER=openai_compatible
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=replace-me
LLM_MODEL=gpt-4.1-mini

CHROMA_PATH=data/chroma
COLLECTION_NAME=sanding_product_knowledge
TOP_K=4
MIN_RELEVANCE=0.60
# 仅供离线保留评估比较；不使用 data/test_questions.json 调阈值。
EVALUATION_THRESHOLDS=0.30,0.45,0.60,0.70
